{
  "name": "diskmon-webui",
  "private": true,
  "version": "0.5.0",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "scripts": {
    "preinstall": "bunx only-allow bun >/dev/null 2>&1 || bun -e \"if (!(process.env.npm_execpath || '').includes('bun')) { console.error('Use bun install for this project.'); process.exit(1) }\"",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.vue",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.0.1",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^17.0.0",
    "jsdom": "^29.0.0",
    "tailwindcss": "^4.3.2",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
